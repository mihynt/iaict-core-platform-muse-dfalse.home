{
  // IAICT Core Platform — Cloudflare Python Worker (beta hosting, DEC-006).
  // Run ./build.sh first so src/ contains entry.py + the app package.
  "name": "iaict-core-platform",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "APP_ENV": "beta"
  }
  // Secrets (never commit values):
  //   wrangler secret put PLATFORM_ADMIN_KEY
  // Hyperdrive binding — the store layer (app/workerstore.py, pg8000) is
  // ready and selected by src/entry.py; activate by creating the config
  // (dashboard: Workers & Pages -> Hyperdrive -> Create, name iaict-neon,
  // direct Neon connection string) and uncommenting with its id:
  //   "hyperdrive": [
  //     { "binding": "HYPERDRIVE", "id": "<hyperdrive config id>" }
  //   ]
  // Until then /health reports storage "memory" (the in-memory fallback).
}
