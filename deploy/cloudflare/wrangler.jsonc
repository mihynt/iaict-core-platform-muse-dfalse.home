{
  // IAICT Core Platform — Cloudflare Python Worker (beta hosting, DEC-006).
  // Run ./build.sh first so src/ contains entry.py + the app package.
  "name": "iaict-core-platform",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "APP_ENV": "beta"
  },
  // Hyperdrive config "iaict-neon" (created by the Owner in the dashboard
  // on 2026-11-02; direct Neon connection string, caching disabled).
  // The store layer (app/workerstore.py, pg8000) binds it from the first
  // request's env; /health reports storage "postgresql-hyperdrive".
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "3cdbf0e61cfc4a078ea1f4790200a65f" }
  ]
  // Secrets (never commit values):
  //   wrangler secret put PLATFORM_ADMIN_KEY
}
