{
  // IAICT Core Platform — Cloudflare Python Worker (beta hosting, DEC-006).
  // Run ./build.sh first so src/ contains entry.py + the app package.
  "name": "iaict-core-platform",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "APP_ENV": "beta"
  },
  // Web UI: static files in ./public, served through the Worker so the
  // app can proxy them behind the API origin (see the catch-all route in
  // backend/app/main.py). run_worker_first keeps API routes authoritative.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Hyperdrive config "iaict-supabase" (created by the Owner in the
  // dashboard on 2026-11-02; Supabase direct connection string, caching
  // disabled). Switched from "iaict-neon" (id 3cdbf0e61cfc4a078ea1f4790200a65f,
  // kept intact for instant rollback) for the Supabase trial at STATE rev 18.
  // The store layer (app/workerstore.py, pg8000) binds it from the first
  // request's env; /health reports storage "postgresql-hyperdrive".
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "4ee90fdeba69436493d69e11fd7a870b" }
  ]
  // Secrets (never commit values):
  //   wrangler secret put PLATFORM_ADMIN_KEY
}
